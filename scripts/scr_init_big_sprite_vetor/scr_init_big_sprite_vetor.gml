function scr_init_big_sprite_vetor(){
	var i = 0;
	big_sprite_vetor[i++] = spr_unicard_back; 
	big_sprite_vetor[i++] = spr_big_unicard_robotic_cens; //robotico
	big_sprite_vetor[i++] = spr_big_unicard_time_cens; //atrso
	big_sprite_vetor[i++] = spr_big_unicard_poison_cens; //poison
	big_sprite_vetor[i++] = spr_big_unicard_pacific_cens;//pacifico
	big_sprite_vetor[i++] = spr_big_unicard_eletric_cens; //eletrico
	big_sprite_vetor[i++] = spr_big_unicard_bracorobotico; //braço robotico
	big_sprite_vetor[i++] = spr_big_unicard_semblante_da_ganancia; // semblance da gananica
	big_sprite_vetor[i++] = spr_big_unicard_coic; // barramento do coic
	big_sprite_vetor[i++] = spr_big_unicard_energy_eletricity; // energia eletrica
	big_sprite_vetor[i++] = spr_big_unicard_item_heal_potion; // pocao de cura
	big_sprite_vetor[i++] = spr_big_unicard_man_in_the_middle; // man in the middle
	big_sprite_vetor[i++] = spr_big_unicard_hacker_cens; //hacker
	
	
	
return;
}