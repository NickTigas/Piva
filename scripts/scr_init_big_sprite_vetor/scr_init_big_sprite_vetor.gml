function scr_init_big_sprite_vetor(){
	var i = 0;
	big_sprite_vetor[i++] = spr_unicard_back;
	big_sprite_vetor[i++] = spr_big_unicard_common;
	big_sprite_vetor[i++] = spr_big_unicard_rare;
	big_sprite_vetor[i++] = spr_big_unicard_epic;
	big_sprite_vetor[i++] = spr_big_unicard_legendary;
	big_sprite_vetor[i++] = spr_big_unicard_moreira;
	big_sprite_vetor[i++] = spr_big_unicard_bracorobotico;
	
return;
}