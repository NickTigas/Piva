function scr_init_big_sprite_vetor(){
	var i = 0;
	big_sprite_vetor[i++] = spr_unicard_back; 
	big_sprite_vetor[i++] = spr_big_unicard_common; //cida
	big_sprite_vetor[i++] = spr_big_unicard_rare; //ronaldo
	big_sprite_vetor[i++] = spr_big_unicard_epic; //piva
	big_sprite_vetor[i++] = spr_big_unicard_legendary;//place holder
	big_sprite_vetor[i++] = spr_big_unicard_moreira; //moreira
	big_sprite_vetor[i++] = spr_big_unicard_bracorobotico; //braço robotico
	big_sprite_vetor[i++] = spr_big_unicard_potedaganancia; // pote da gananica
	big_sprite_vetor[i++] = spr_big_unicard_coic; // barramento do coic
	
return;
}