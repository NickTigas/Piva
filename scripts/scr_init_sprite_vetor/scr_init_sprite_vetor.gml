function scr_init_sprite_vetor(){
var i = 0;
sprite_vetor[i++] = spr_unicard_back; 
sprite_vetor[i++] = spr_unicard_common; //cida
sprite_vetor[i++] = spr_unicard_rare; //ronaldo
sprite_vetor[i++] = spr_unicard_piva; //piva
sprite_vetor[i++] = spr_unicard_legendary; //place holder
sprite_vetor[i++] = spr_unicard_moreira; //moreira
sprite_vetor[i++] = spr_unicard_bracorobotico; //braço robotico
sprite_vetor[i++] = spr_unicard_semblante_da_ganancia; // semblante da ganancia
sprite_vetor[i++] = spr_unicard_coic; //barramento coic
sprite_vetor[i++] = spr_unicard_energy_eletricity; // energia eletrica
sprite_vetor[i++] = spr_unicard_item_heal_potion; // pocao de cura

return;
}