function scr_init_sprite_vetor(){
var i = 0;
sprite_vetor[i++] = spr_unicard_back; 
sprite_vetor[i++] = spr_unicard_robotic_cens; //robotico
sprite_vetor[i++] = spr_unicard_time_cens; //atraso
sprite_vetor[i++] = spr_unicard_poison_cens; //poison
sprite_vetor[i++] = spr_unicard_pacific_cens; //pacifico
sprite_vetor[i++] = spr_unicard_eletric_cens; //eletrico
sprite_vetor[i++] = spr_unicard_bracorobotico; //braço robotico
sprite_vetor[i++] = spr_unicard_semblante_da_ganancia; // semblante da ganancia
sprite_vetor[i++] = spr_unicard_coic; //barramento coic
sprite_vetor[i++] = spr_unicard_energy_eletricity; // energia eletrica
sprite_vetor[i++] = spr_unicard_item_heal_potion; // pocao de cura
sprite_vetor[i++] = spr_unicard_man_in_the_middle; // man in the middle
sprite_vetor[i++] = spr_unicard_hacker_cens; // hacker

return;
}